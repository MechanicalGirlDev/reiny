{
  "name": "@reiny/ffi",
  "version": "0.1.0",
  "type": "module",
  "description": "Node.js JavaScript and TypeScript bindings for reiny",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "README.md", "examples"],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "smoke": "node examples/local.js",
    "smoke:typescript": "tsx examples/local.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "koffi": "^3.0.0" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
